                <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span> Cinta Transportadora Activa (Memoria RAM)
            </div>
            <div class="flex justify-center flex-wrap gap-2.5 md:gap-3" id="cinta">
                <!-- Se llena dinámicamente -->
            </div>
        </div>

        <!-- Panel de Reto Actual -->
        <div class="bg-gradient-to-br from-slate-950 to-slate-900 p-5 rounded-2xl mb-6 border border-cyan-500/20 shadow-lg relative">
            <div class="absolute -top-2.5 left-4 bg-cyan-500 text-slate-950 text-[10px] font-extrabold uppercase px-2.5 py-0.5 rounded-full tracking-wider">
                Misión del Operador
            </div>
            <h2 id="titulo-reto" class="text-sm md:text-base font-bold text-cyan-300 mb-1 mt-1">Cargando instrucción...</h2>
